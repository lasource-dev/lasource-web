---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const comparatifs = await getCollection('comparatifs');
const published = comparatifs
  .filter((c) => c.data.status === 'published' || c.data.status === 'draft')
  .sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime());
---

<Layout title="Comparatifs" description="Comparatifs détaillés des frameworks IA/ML — LaSource.dev">
  <section>
    <h1>Comparatifs</h1>
    <p class="subtitle">Analyses détaillées pour choisir le bon framework selon votre projet.</p>

    <div class="grid">
      {published.map((entry) => (
        <a href={`/comparatifs/${entry.id}`} class="card">
          <div class="tags">
            {entry.data.libraries_compared.map((lib: string) => (
              <span class="tag">{lib}</span>
            ))}
          </div>
          <h2>{entry.data.title}</h2>
          <p class="reco">{entry.data.recommendation}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  section {
    padding: 32px 0;
  }
  h1 {
    font-size: 26px;
    margin: 0 0 4px;
  }
  .subtitle {
    color: var(--text-secondary);
    font-size: 15px;
    margin: 0 0 32px;
  }
  .grid {
    display: grid;
    gap: 16px;
  }
  .card {
    display: block;
    text-decoration: none;
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 24px;
    transition: border-color 0.15s;
  }
  .card:hover {
    border-color: var(--accent);
  }
  .tags {
    display: flex;
    gap: 8px;
  }
  .tag {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--accent);
    background: var(--accent-bg);
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 600;
  }
  .card h2 {
    font-size: 16px;
    margin: 10px 0 8px;
  }
  .reco {
    font-size: 14px;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
    font-style: italic;
  }
</style>
