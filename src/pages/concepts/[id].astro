---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  return concepts.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.explanation}>
  <article>
    <span class="tag">{entry.data.library} {entry.data.version && <span class="muted">v{entry.data.version}</span>}</span>
    <h1>{entry.data.title}</h1>
    <p class="explanation">{entry.data.explanation}</p>

    {entry.data.gotcha && (
      <div class="gotcha">
        <p class="gotcha-title">⚠️ Point d'attention</p>
        <p>{entry.data.gotcha}</p>
      </div>
    )}

    <div class="content">
      <Content />
    </div>

    {entry.data.see_also && entry.data.see_also.length > 0 && (
      <div class="see-also">
        <p class="see-also-title">Voir aussi</p>
        <ul>
          {entry.data.see_also.map((ref: string) => (
            <li><a href={`/concepts/${ref}`}>{ref}</a></li>
          ))}
        </ul>
      </div>
    )}
  </article>
</Layout>

<style>
  article {
    padding: 32px 0;
    max-width: 720px;
  }
  .tag {
    font-size: 12px;
    color: var(--accent);
  }
  .muted {
    color: var(--text-muted);
  }
  h1 {
    font-size: 26px;
    margin: 8px 0 12px;
  }
  .explanation {
    font-size: 15px;
    color: var(--text-secondary);
    margin: 0 0 20px;
  }
  .gotcha {
    background: #fffbe6;
    border: 1px solid #f0e4a0;
    border-radius: var(--radius);
    padding: 14px 16px;
    margin: 0 0 24px;
  }
  .gotcha-title {
    font-weight: 600;
    font-size: 13px;
    margin: 0 0 4px;
  }
  .gotcha p:last-child {
    font-size: 14px;
    margin: 0;
    color: var(--text-secondary);
  }
  .content {
    font-size: 15px;
    line-height: 1.7;
  }
  .content :global(h2) {
    font-size: 20px;
    margin: 32px 0 12px;
  }
  .content :global(h3) {
    font-size: 16px;
    margin: 24px 0 8px;
  }
  .content :global(pre) {
    background: var(--surface-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.5;
  }
  .content :global(code) {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 0.9em;
  }
  .content :global(p code) {
    background: var(--surface-alt);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .content :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    margin: 16px 0;
  }
  .content :global(th),
  .content :global(td) {
    border: 1px solid var(--border);
    padding: 8px 12px;
    text-align: left;
  }
  .content :global(th) {
    background: var(--surface-alt);
    font-weight: 600;
  }
  .see-also {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  .see-also-title {
    font-weight: 600;
    font-size: 14px;
    margin: 0 0 8px;
  }
  .see-also ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .see-also li {
    margin: 4px 0;
  }
  .see-also a {
    font-size: 14px;
  }
</style>
