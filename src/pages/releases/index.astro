---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const releases = (await getCollection('releases')).sort(
  (a, b) => b.data.updated.valueOf() - a.data.updated.valueOf()
);
---

<Layout title="Releases">
  <h1>Fiches release</h1>
  <div class="list">
    {releases.length === 0 && <p class="empty">Aucune fiche release publiée pour le moment.</p>}
    {releases.map((r) => (
      <a href={`/releases/${r.id}`} class="row">
        <div>
          <span class="tag">{r.data.library} <span class="muted">{r.data.version}</span></span>
          <p class="title">{r.data.title}</p>
        </div>
        <span class="muted">{r.data.updated.toLocaleDateString('fr-FR')}</span>
      </a>
    ))}
  </div>
</Layout>

<style>
  h1 {
    font-size: 22px;
    margin: 32px 0 20px;
  }
  .list {
    border-top: 1px solid var(--border);
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: var(--text-primary);
  }
  .tag {
    font-size: 11px;
    color: var(--accent);
  }
  .title {
    font-size: 14px;
    margin: 4px 0 0;
  }
  .muted {
    font-size: 12px;
    color: var(--text-muted);
  }
  .empty {
    color: var(--text-muted);
    font-size: 13px;
  }
</style>
