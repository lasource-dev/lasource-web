---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const tutoriels = (await getCollection('tutoriels'))
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf())
  .slice(0, 3);

const releases = (await getCollection('releases'))
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf())
  .slice(0, 3);

const libraries = [
  'langchain', 'transformers', 'vllm', 'ollama', 'crewai',
  'llama_index', 'llama_cpp', 'pydantic-ai', 'langflow',
  'dify', 'ragflow', 'mem0', 'instructor', 'autogen', 'litellm',
];
---

<Layout title="Accueil">
  <section class="hero">
    <span class="badge">15 frameworks IA, 0 concurrent en français</span>
    <h1>La doc IA/ML en français, dans votre IDE</h1>
    <p>Tutoriels, snippets et guides de migration pour LangChain, vLLM, Transformers et 12 autres frameworks — pas un proxy de doc brute.</p>
    <div class="hero-actions">
      <a href="/mcp" class="btn btn-primary">Installer dans mon IDE →</a>
      <a href="/tutoriels" class="btn btn-secondary">Parcourir la doc</a>
    </div>
  </section>

  <section class="libraries">
    <p class="section-label">Bibliothèques couvertes</p>
    <div class="chips">
      {libraries.map((lib) => (
        <a href={`/bibliotheques/${lib}`} class="chip">{lib}</a>
      ))}
    </div>
  </section>

  <section>
    <p class="section-label">Derniers tutoriels</p>
    <div class="grid">
      {tutoriels.length === 0 && <p class="empty">Aucun tutoriel publié pour le moment.</p>}
      {tutoriels.map((t) => (
        <a href={`/tutoriels/${t.id}`} class="card">
          <span class="card-tag">{t.data.library}</span>
          <p class="card-title">{t.data.title}</p>
        </a>
      ))}
    </div>
  </section>

  <section>
    <p class="section-label">Fiches release récentes</p>
    <div class="release-list">
      {releases.length === 0 && <p class="empty">Aucune fiche release publiée pour le moment.</p>}
      {releases.map((r) => (
        <a href={`/releases/${r.id}`} class="release-row">
          <span>{r.data.library} <span class="muted">{r.data.version}</span></span>
          <span class="muted">{r.data.updated.toLocaleDateString('fr-FR')}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="mcp-banner">
    <div>
      <p class="banner-title">Recevez la doc directement dans votre éditeur</p>
      <p class="banner-sub">Cursor, VS Code, Claude Desktop — un seul MCP Server.</p>
    </div>
    <a href="/mcp" class="btn btn-primary">Voir l'installation</a>
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 56px 0 40px;
  }
  .badge {
    display: inline-block;
    font-size: 12px;
    color: var(--accent);
    background: var(--accent-bg);
    padding: 4px 12px;
    border-radius: var(--radius);
    margin-bottom: 16px;
  }
  .hero h1 {
    font-size: 32px;
    margin: 0 0 12px;
  }
  .hero p {
    color: var(--text-secondary);
    max-width: 480px;
    margin: 0 auto 24px;
    font-size: 15px;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
  }
  .btn {
    display: inline-block;
    padding: 10px 18px;
    border-radius: var(--radius);
    font-size: 14px;
    text-decoration: none;
    font-weight: 500;
  }
  .btn-primary {
    background: var(--accent);
    color: white;
  }
  .btn-secondary {
    background: var(--surface);
    color: var(--text-primary);
    border: 1px solid var(--border);
  }
  .section-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    margin: 40px 0 12px;
  }
  .libraries {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 24px 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    font-size: 12px;
    padding: 5px 12px;
    background: var(--surface-alt);
    border-radius: 20px;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    text-decoration: none;
  }
  .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .card {
    background: var(--surface-alt);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px;
    text-decoration: none;
    color: var(--text-primary);
  }
  .card-tag {
    font-size: 11px;
    color: var(--accent);
  }
  .card-title {
    font-size: 13px;
    margin: 6px 0 0;
  }
  .release-list {
    background: var(--surface-alt);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 4px 16px;
  }
  .release-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
    text-decoration: none;
    color: var(--text-primary);
  }
  .release-row:last-child {
    border-bottom: none;
  }
  .muted {
    color: var(--text-muted);
  }
  .mcp-banner {
    margin: 40px 0 0;
    padding: 18px 20px;
    background: var(--accent-bg);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .banner-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 4px;
  }
  .banner-sub {
    font-size: 12px;
    color: var(--accent);
    margin: 0;
  }
  .empty {
    color: var(--text-muted);
    font-size: 13px;
  }
</style>
