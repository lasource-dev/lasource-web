# PostgreSQL connection string used by Payload CMS.
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/lasource

# Vercel/Neon provides DATABASE_URL automatically. DATABASE_URI takes
# precedence when both variables are present.
# DATABASE_URL=postgresql://user:password@host/database

# Secret used to sign Payload CMS authentication tokens.
# Generate one with: openssl rand -base64 32
PAYLOAD_SECRET=replace-with-at-least-32-random-characters

# Canonical public URL, without a trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional token from the Google Search Console HTML-tag verification method.
# Store only the content value, without the surrounding <meta> tag.
# GOOGLE_SITE_VERIFICATION=google-site-verification-token

# Protects the hourly GPU price synchronization endpoint. Vercel sends this
# value as a Bearer token when CRON_SECRET is configured on the project.
CRON_SECRET=replace-with-a-long-random-secret

# Optional provider keys. Azure Retail Prices works without authentication;
# these keys enable the RunPod and Vast.ai connectors.
# RUNPOD_API_KEY=
# VAST_API_KEY=
