From 231a0ded4c5e99192c3ee778e1ade16125a8a2b3 Mon Sep 17 00:00:00 2001
From: "Claude (LaSource)" <claude@lasource.dev>
Date: Sat, 18 Jul 2026 14:34:49 +0000
Subject: [PATCH] =?UTF-8?q?fix:=20supprimer=20adaptateur=20Cloudflare=20?=
 =?UTF-8?q?=E2=80=94=20SSG=20pur?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

L'adaptateur @astrojs/cloudflare générait dist/client/ + dist/server/
au lieu d'un simple dist/ statique. Cloudflare Pages ne trouvait pas
les fichiers. SSG pur = pas d'adaptateur, pas de wrangler.jsonc.
---
 astro.config.mjs |  6 ------
 wrangler.jsonc   | 14 --------------
 2 files changed, 20 deletions(-)
 delete mode 100644 wrangler.jsonc

diff --git a/astro.config.mjs b/astro.config.mjs
index a90b373..4df16fa 100644
--- a/astro.config.mjs
+++ b/astro.config.mjs
@@ -1,12 +1,6 @@
 import { defineConfig } from 'astro/config';
 
-import cloudflare from '@astrojs/cloudflare';
-
-// Mode SSG pur (section 10 de la note stratégique).
-// Aucun adaptateur nécessaire : la sortie est un dossier dist/ statique,
-// déployé tel quel sur Cloudflare Pages.
 export default defineConfig({
   site: 'https://lasource.dev',
   output: 'static',
-  adapter: cloudflare(),
 });
\ No newline at end of file
diff --git a/wrangler.jsonc b/wrangler.jsonc
deleted file mode 100644
index 47693fc..0000000
--- a/wrangler.jsonc
+++ /dev/null
@@ -1,14 +0,0 @@
-{
-	"$schema": "./node_modules/wrangler/config-schema.json",
-	"compatibility_date": "2026-07-13",
-	"compatibility_flags": ["global_fetch_strictly_public"],
-	"name": "lasource-web",
-	"main": "@astrojs/cloudflare/entrypoints/server",
-	"assets": {
-		"directory": "./dist",
-		"binding": "ASSETS"
-	},
-	"observability": {
-		"enabled": true
-	}
-}
\ No newline at end of file
-- 
