# PostgreSQL connection string used by Payload CMS.
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/lasource

# Vercel/Neon provides DATABASE_URL automatically. DATABASE_URI takes
# precedence when both variables are present.
# DATABASE_URL=postgresql://user:password@host/database

# Secret used to sign Payload CMS authentication tokens.
# Generate one with: openssl rand -base64 32
PAYLOAD_SECRET=replace-with-at-least-32-random-characters

# Canonical public URL, without a trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
